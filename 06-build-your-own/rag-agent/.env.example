# Copy to .env and edit. The app reads these at startup.

# --- pick your backend: "ollama" (local/free) or "anthropic" (cloud) ---
LLM_PROVIDER=ollama

# --- Anthropic (only needed when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# --- Ollama (only used when LLM_PROVIDER=ollama) ---
# Inside docker-compose, the service hostname is "ollama".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# --- retrieval tuning ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=4
CHROMA_DIR=./data/chroma
COLLECTION=docs
